---
import { getSortedPosts } from '@lib/astro/post'
import { paginate } from '@lib/paginate'

import { BLOG_HOME_SLUG, LATEST_SLUG } from '@/consts'
import BlogPostsLayout from '@/layouts/BlogPostsLayout.astro'

import { joinSlug } from '@/lib/post/join-slug'
import { produce } from 'immer'

export async function getStaticPaths() {
  const posts = await getSortedPosts()

  const featuredPosts = posts.filter(post => post.data.featured)
  const otherPosts = posts.filter(post => !post.data.featured)

  const paths = paginate(otherPosts, {
    title: 'Latest Posts',
  }).map(p =>
    produce(p, draft => {
      draft.props.featuredPosts = draft.props.page === 0 ? featuredPosts : []
      draft.props.root = joinSlug(BLOG_HOME_SLUG, LATEST_SLUG)
    })
  )

  return paths
}

const { title, page, pages, root, featuredPosts, data } = Astro.props

const description = `Explore the latest blogs on all things software, finance, news, films, and more. 
Stay updated with fresh insights and stories from my world.`
---

<BlogPostsLayout
  title={title}
  description={description}
  page={page}
  pages={pages}
  featuredPosts={featuredPosts}
  posts={data}
  root={root}
  showTitle={true}
  showSectionLinks={true}
/>

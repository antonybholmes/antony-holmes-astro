---
import { BLOG_HOME_SLUG, type SlugPath } from '@/consts'
import BlogPostLayout from '../../layouts/BlogPostLayout.astro'

import BlogPostsLayout from '@/layouts/BlogPostsLayout.astro'
import { getSortedPosts, type PostWithHero } from '@/lib/astro/post'
import { getPostSectionMap } from '@/lib/astro/sections'
import { getUrlFriendlyTag, PATH_SEP } from '@/lib/http/urls'
import { paginate, type AstroPage, type PageType } from '@/lib/paginate'
import { getPostFlatSlug, joinSlug } from '@/lib/post/join-slug'

import { getSectionDescription } from '@/sections'
import { produce } from 'immer'

export async function getStaticPaths() {
  let posts = await getSortedPosts()

  let paths: AstroPage<PostWithHero>[] = []

  // create a page for every post
  for (const post of posts) {
    // If the post has sections, create a path for each section
    // flatten slug to the last part of the path
    // e.g. /test/my-post/ becomes /my-post/
    // this is useful for SEO and readability

    // url friendly last part of the id
    const slug = getPostFlatSlug(post) //  getPostSlugs(post)

    //for (const slug of slugs) {
    // we decouple the file storage structure from the URL structure
    // by flattening the slug to only use the last part of the path
    // and combining it with the section

    // path for a post is the flattened slug without sections
    paths.push({
      params: { slug },
      props: {
        type: 'post',
        title: post.data.title,
        root: BLOG_HOME_SLUG,
        page: 0,
        pages: 1,
        data: [post],
      },
    })
    //}
  }

  const sectionMap = getPostSectionMap(posts)

  for (const [section, posts] of sectionMap.entries()) {
    const featuredPosts = posts.filter(post => post.data.featured)
    const otherPosts = posts.filter(post => !post.data.featured)

    const sectionParts = section.split(PATH_SEP).map(part => part.trim())
    const title = sectionParts[sectionParts.length - 1] || 'Blog'

    // we need slug to be relative to blog beacause we are generating
    // pages in the blog folder
    const slug: SlugPath = sectionParts.map(s => ({
      name: s,
      path: getUrlFriendlyTag(s),
    }))

    const description = getSectionDescription(title)

    const pages = paginate(otherPosts, { slug, title }).map(p =>
      produce(p, draft => {
        //the root needs to be the full path to the section,
        // so we can generate the correct links for pagination
        // and for the "back to section" link
        draft.props.root = joinSlug(BLOG_HOME_SLUG, slug)
        draft.props.featuredPosts = p.props.page === 0 ? featuredPosts : []
        draft.props.description = description
      })
    )

    paths = paths.concat(pages)
  }

  return paths
}

interface Props {
  type: PageType
  title?: string
  description?: string
  root?: SlugPath
  page: number
  pages: number
  data: PostWithHero[]
  featuredPosts?: PostWithHero[]
}

const { type, title, description, root, page, pages, data, featuredPosts } =
  Astro.props
---

{
  (type == 'post' || type == 'review') && data.length > 0 && (
    <BlogPostLayout post={data[0]} />
  )
}

<!-- Render a page containing a list of posts -->
{
  type === 'posts' && (
    <BlogPostsLayout
      title={title!}
      description={description}
      page={page}
      pages={pages}
      posts={data}
      featuredPosts={featuredPosts}
      root={root}
      showSectionLinks={root![0].name === BLOG_HOME_SLUG[0].name}
    />
  )
}

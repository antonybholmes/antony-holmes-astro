---
import { getSortedPosts } from '@lib/astro/post'
import { paginate } from '@lib/paginate'

import { BLOG_HOME_SLUG, PHOTOS_DESCRIPTION, PHOTOS_SLUG } from '@/consts'
import BlogPostsLayout from '@/layouts/BlogPostsLayout.astro'
import { joinSlug } from '@/lib/post/join-slug'
import { produce } from 'immer'

export async function getStaticPaths() {
  let posts = await getSortedPosts()

  posts = posts.filter(post =>
    post.data.sections?.some(section => section.includes('Photos'))
  )

  const featuredPosts = posts.filter(post => post.data.featured)
  const otherPosts = posts.filter(post => !post.data.featured)

  const paths = paginate(otherPosts, { title: 'Photos' }).map(p =>
    produce(p, draft => {
      draft.props.featuredPosts = draft.props.page === 0 ? featuredPosts : []
      draft.props.root = joinSlug(BLOG_HOME_SLUG, PHOTOS_SLUG)
    })
  )

  return paths
}

const { title, root, page, pages, featuredPosts, data } = Astro.props
---

<BlogPostsLayout
  title={title}
  description={PHOTOS_DESCRIPTION}
  page={page}
  pages={pages}
  featuredPosts={featuredPosts}
  posts={data}
  root={root}
  showTitle={true}
  showSectionLinks={true}
  tab="Photos"
/>

---
import type { SlugPath } from '@/consts'
import { render } from 'astro:content'

import { VCenterRow } from '@/components/layout/v-center-row'
import { TableOfContents } from '@/components/toc'
import { Calendar, Minus, Plus } from 'lucide-react'

import { Breadcrumb } from '@/components/breadcrumb'
import { FormattedDate } from '@/components/formatted-date'
import FormattedReadTime from '@/components/FormattedReadTime.astro'
import { BaseCol } from '@/components/layout/base-col'
import ContentDiv from '@/components/layout/ContentDiv.astro'
import SidebarDiv from '@/components/layout/SidebarDiv.astro'
import { ThemeLink } from '@/components/link/theme-link'
import { HeroImageCaption } from '@/components/posts/hero-image-caption'
import { StarRating } from '@/components/posts/star-rating'
import { SideTags } from '@/components/side-tags'
import { BLOG_HOME_SLUG, SITE_URL, TARGET_BLANK } from '@/consts'
import type { ColorMode } from '@/interfaces/color-mode'
import type { PostWithHero } from '@/lib/astro/post'
import { getPostFlatSlug } from '@/lib/post/join-slug'
import { type IPost } from '@/lib/post/post'
import { getPostSectionBreadcrumbs } from '@/lib/post/slug'
import { CompactAvatars } from '@components/people/compact-avatars'
import { format } from 'date-fns'
import BaseLayout from './BaseLayout.astro'

// type Props = CollectionEntry<'blog'>['data'] & {
//   slug: string
//   minutesRead: string
//   //lastModified: Date
//   headings: {
//     depth: number
//     slug: string
//     text: string
//   }[]
// }

interface Props {
  post: PostWithHero
  mode?: ColorMode
  root?: SlugPath
}

// const {
//   title,
//   description,
//   added,
//   updated,
//   hero,
//   slug,
//   minutesRead,
//   tags,
// } = Astro.props

let { post, mode = 'dark', root } = Astro.props

const slug = getPostFlatSlug(post)

const { Content, remarkPluginFrontmatter } = await render(post)

// use png for og images and compatibility
const ogImage = `${SITE_URL}/assets/images/og/${slug}.png` //png`/assets/images/og/${slug}.webp` //png

// const hero = post.data.hero
//   ? post.data.hero
//   : `/assets/images/blog/${slug}.webp`

if (!root) {
  root = BLOG_HOME_SLUG
}

const crumbs = getPostSectionBreadcrumbs(post, root)

const dateAdded = post.data.added ? post.data.added : new Date()
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.hero}
  tab="Blog"
  mode={mode}
>
  <Fragment slot="head">
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:image" content={ogImage} />
  </Fragment>

  <!-- index for searching data-pagefind-body -->
  <article
    slot="main"
    class="relative flex flex-col gap-y-16"
    data-pagefind-body
  >
    <header class="relative">
      <span
        class="absolute top-0 left-0 z-0 h-96 w-full bg-gray-800 lg:h-128 dark:invisible"
        id="blog-header-bg"></span>

      <ContentDiv className="relative z-10 mt-24" colCls="lg:w-1/2">
        <BaseCol slot="main" className="gap-y-8 lg:gap-y-12">
          <Breadcrumb crumbs={crumbs} mode={mode} />

          <BaseCol className="gap-y-3 lg:gap-y-6">
            <h1
              class="text-4xl font-bold tracking-tight data-[mode=dark]:text-white lg:text-5xl"
              data-mode={mode}
            >
              {post.data.title}
            </h1>

            {
              post.data.description && (
                <p
                  class="text-foreground/70 text-lg data-[mode=dark]:text-white/50"
                  data-mode={mode}
                >
                  {post.data.description}
                </p>
              )
            }

            {
              post.data.resolvedHero && (
                <div class="group relative aspect-video w-full overflow-hidden rounded-2xl">
                  <img
                    src={post.data.resolvedHero}
                    alt={post.data.heroAlt || post.data.title}
                    class="w-full scale-102 object-cover object-center transition-transform duration-500 ease-in-out group-hover:scale-105"
                    loading="lazy"
                  />

                  {post.data.heroAlt && (
                    <HeroImageCaption
                      post={post as IPost}
                      className="duration-500 opacity-0 transition-opacity group-hover:opacity-100"
                    />
                  )}
                </div>
              )
            }
          </BaseCol>
        </BaseCol>
      </ContentDiv>
    </header>

    <ContentDiv colCls="lg:w-1/2">
      <BaseCol slot="main" className="gap-y-8">
        <BaseCol className="gap-y-4 text-sm">
          <VCenterRow className="justify-between gap-x-2">
            <CompactAvatars people={post.data.authors ?? []} />

            {
              post.data.links && (
                <ul class="flex flex-row items-center gap-x-4">
                  {post.data.links.map(link => (
                    <li>
                      <ThemeLink
                        href={link.url}
                        target={TARGET_BLANK}
                        startingColor="text-theme"
                      >
                        {link.title}
                      </ThemeLink>
                    </li>
                  ))}
                </ul>
              )
            }
          </VCenterRow>

          <VCenterRow
            data-mode="light"
            className="text-foreground/50 gap-x-5 data-[mode=dark]:text-white"
          >
            <VCenterRow className="gap-x-2">
              <Calendar
                data-mode="light"
                className="stroke-foreground/40 w-5 data-[mode=dark]:stroke-white"
                strokeWidth={1.5}
              />
              <FormattedDate date={dateAdded} />
            </VCenterRow>

            <FormattedReadTime
              readingTime={remarkPluginFrontmatter.minutesRead}
            />
          </VCenterRow>

          {
            post.data.updated &&
              post.data.updated.getTime() > post.data.added.getTime() && (
                <span
                  data-mode="light"
                  class="text-foreground/50 gap-x-2 italic data-[mode=dark]:text-white"
                >
                  Updated on {format(post.data.updated, 'MMM dd, yyyy')}
                </span>
              )
          }

          <SideTags tags={post.data.tags} className="md:hidden" />
        </BaseCol>

        <SidebarDiv mainCls="gap-y-8">
          <Fragment slot="main">
            {
              post.data.rating && (
                <VCenterRow className="gap-x-4">
                  {post.data.rating && <StarRating rating={post.data.rating} />}
                </VCenterRow>
              )
            }

            {
              post.data.pros && (
                <section
                  id="pros-and-cons"
                  class="grid grid-cols-1 gap-6 text-sm lg:grid-cols-2"
                >
                  <BaseCol className="gap-2 bg-emerald-50 p-5 rounded-xl text-emerald-600">
                    <h3 class="text-lg font-semibold">Pros</h3>
                    <ul class="flex flex-col gap-2">
                      {post.data.pros.map(p => (
                        <li class="flex flex-row items-center gap-x-2">
                          <VCenterRow className="justify-center shrink-0 bg-emerald-400 rounded-full w-4.5 h-4.5 aspect-square">
                            <Plus stroke="white" className="w-5 h-5" />
                          </VCenterRow>
                          <span>{p}</span>
                        </li>
                      ))}
                    </ul>
                  </BaseCol>
                  {post.data.cons && (
                    <BaseCol className="gap-2 bg-red-50 p-5 rounded-xl text-red-600">
                      <h3 class="text-lg font-semibold">Cons</h3>
                      <ul class="flex flex-col gap-2">
                        {post.data.cons.map(p => (
                          <li class="flex flex-row items-center gap-x-2">
                            <VCenterRow className="justify-center shrink-0 bg-red-400 rounded-full w-4.5 h-4.5 aspect-square">
                              <Minus stroke="white" className="w-5 h-5" />
                            </VCenterRow>
                            <span>{p}</span>
                          </li>
                        ))}
                      </ul>
                    </BaseCol>
                  )}
                </section>
              )
            }

            <section class="markdown post">
              <Content />
            </section>

            <!-- <SideTags tags={post.data.tags} className="md:hidden" /> -->
          </Fragment>
          <BaseCol className="sticky top-20 gap-12" slot="side">
            <SideTags tags={post.data.tags} />
            <TableOfContents client:only="react" />
            <!--  <LatestPosts /> -->
          </BaseCol>
        </SidebarDiv>
      </BaseCol>
    </ContentDiv>
  </article>
</BaseLayout>
